rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Global Security Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isVerifiedOwner(userId) {
      return isVerifiedUser() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidDateKey(dateKey) {
      return dateKey is string && dateKey.size() == 10 && dateKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function isOptionalString(data, field, maxLen) {
      return !(field in data) || data[field] == null || (data[field] is string && data[field].size() <= maxLen);
    }

    // 3. Entity Validation Blueprints
    function isValidRecipe(data, recipeId, userId) {
      return data.keys().hasAll([
          'id', 'ownerId', 'title', 'category', 'cuisineType',
          'prepDuration', 'prepMinutes', 'servings', 'ingredients',
          'steps', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'ownerId', 'title', 'category', 'cuisineType',
          'prepDuration', 'prepMinutes', 'servings', 'ingredients',
          'steps', 'tags', 'imageUrl', 'imageHint', 'sourceUrl',
          'createdAt', 'updatedAt'
        ])
        && isValidId(data.id) && data.id == recipeId
        && isValidId(data.ownerId) && data.ownerId == userId && data.ownerId == request.auth.uid
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 200
        && data.category in ['plat', 'entree', 'accompagnement']
        && data.cuisineType in ['classique', 'végétarien', 'poisson', 'convivial', 'rapide', 'healthy']
        && data.prepDuration in ['rapide', 'moyen', 'long']
        && (data.prepMinutes is int || data.prepMinutes is float) && data.prepMinutes >= 1 && data.prepMinutes <= 600
        && (data.servings is int || data.servings is float) && data.servings >= 1 && data.servings <= 50
        && data.ingredients is list && data.ingredients.size() <= 50
        && (data.ingredients.size() == 0 || data.ingredients[0] is map)
        && data.steps is list && data.steps.size() <= 40
        && (data.steps.size() == 0 || (data.steps[0] is string && data.steps[0].size() <= 2000))
        && (!('tags' in data) || data.tags == null || (data.tags is list && data.tags.size() <= 15 && (data.tags.size() == 0 || (data.tags[0] is string && data.tags[0].size() <= 50))))
        && isOptionalString(data, 'imageUrl', 1000)
        && isOptionalString(data, 'imageHint', 200)
        && isOptionalString(data, 'sourceUrl', 1000)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidMealSlot(slot) {
      return slot is map
        && slot.keys().hasAll(['isExterior'])
        && slot.keys().hasOnly([
          'isExterior', 'exteriorLabel', 'recipeId', 'customTitle',
          'entree', 'accompagnement', 'notes', 'servingsOverride'
        ])
        && slot.isExterior is bool
        && isOptionalString(slot, 'exteriorLabel', 200)
        && (!('recipeId' in slot) || slot.recipeId == null || isValidId(slot.recipeId))
        && isOptionalString(slot, 'customTitle', 200)
        && isOptionalString(slot, 'entree', 200)
        && isOptionalString(slot, 'accompagnement', 200)
        && isOptionalString(slot, 'notes', 500)
        && (!('servingsOverride' in slot) || slot.servingsOverride == null || ((slot.servingsOverride is int || slot.servingsOverride is float) && slot.servingsOverride >= 1 && slot.servingsOverride <= 50));
    }

    function isValidDayPlan(data, dateKey, userId) {
      return data.keys().hasAll(['date', 'ownerId', 'midi', 'soir', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['date', 'ownerId', 'midi', 'soir', 'createdAt', 'updatedAt'])
        && isValidDateKey(data.date) && data.date == dateKey
        && isValidId(data.ownerId) && data.ownerId == userId && data.ownerId == request.auth.uid
        && isValidMealSlot(data.midi)
        && isValidMealSlot(data.soir)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidGroceryItem(data, itemId, userId) {
      return data.keys().hasAll(['id', 'ownerId', 'name', 'category', 'checked', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly([
          'id', 'ownerId', 'name', 'amount', 'unit',
          'category', 'checked', 'sourceMeal', 'isCustom',
          'createdAt', 'updatedAt'
        ])
        && isValidId(data.id) && data.id == itemId
        && isValidId(data.ownerId) && data.ownerId == userId && data.ownerId == request.auth.uid
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 150
        && (!('amount' in data) || data.amount == null || ((data.amount is int || data.amount is float) && data.amount >= 0 && data.amount <= 100000))
        && isOptionalString(data, 'unit', 40)
        && data.category in ['legumes', 'viandes', 'frais', 'epicerie', 'surgeles', 'autres']
        && data.checked is bool
        && isOptionalString(data, 'sourceMeal', 200)
        && (!('isCustom' in data) || data.isCustom == null || data.isCustom is bool)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // 4. User-Scoped Collections
    match /users/{userId} {
      allow read, write: if false;

      match /recipes/{recipeId} {
        allow get: if isVerifiedOwner(userId) && isValidId(recipeId) && existing().ownerId == request.auth.uid;
        allow list: if isVerifiedOwner(userId) && resource.data.ownerId == request.auth.uid;
        allow create: if isVerifiedOwner(userId)
          && isValidId(recipeId)
          && isValidRecipe(incoming(), recipeId, userId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isVerifiedOwner(userId)
          && isValidId(recipeId)
          && existing().ownerId == request.auth.uid
          && isValidRecipe(incoming(), recipeId, userId)
          && incoming().id == existing().id
          && incoming().ownerId == existing().ownerId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'title', 'category', 'cuisineType', 'prepDuration',
            'prepMinutes', 'servings', 'ingredients', 'steps',
            'tags', 'imageUrl', 'imageHint', 'sourceUrl', 'updatedAt'
          ]);
        allow delete: if isVerifiedOwner(userId) && isValidId(recipeId) && existing().ownerId == request.auth.uid;
      }

      match /schedules/{dateKey} {
        allow get: if isVerifiedOwner(userId) && isValidDateKey(dateKey) && existing().ownerId == request.auth.uid;
        allow list: if isVerifiedOwner(userId) && resource.data.ownerId == request.auth.uid;
        allow create: if isVerifiedOwner(userId)
          && isValidDateKey(dateKey)
          && isValidDayPlan(incoming(), dateKey, userId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isVerifiedOwner(userId)
          && isValidDateKey(dateKey)
          && existing().ownerId == request.auth.uid
          && isValidDayPlan(incoming(), dateKey, userId)
          && incoming().date == existing().date
          && incoming().ownerId == existing().ownerId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['midi', 'soir', 'updatedAt']);
        allow delete: if isVerifiedOwner(userId) && isValidDateKey(dateKey) && existing().ownerId == request.auth.uid;
      }

      match /groceries/{itemId} {
        allow get: if isVerifiedOwner(userId) && isValidId(itemId) && existing().ownerId == request.auth.uid;
        allow list: if isVerifiedOwner(userId) && resource.data.ownerId == request.auth.uid;
        allow create: if isVerifiedOwner(userId)
          && isValidId(itemId)
          && isValidGroceryItem(incoming(), itemId, userId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isVerifiedOwner(userId)
          && isValidId(itemId)
          && existing().ownerId == request.auth.uid
          && isValidGroceryItem(incoming(), itemId, userId)
          && incoming().id == existing().id
          && incoming().ownerId == existing().ownerId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'name', 'amount', 'unit', 'category', 'checked', 'sourceMeal', 'isCustom', 'updatedAt'
          ]);
        allow delete: if isVerifiedOwner(userId) && isValidId(itemId) && existing().ownerId == request.auth.uid;
      }
    }
  }
}
