# Server-side Gemini API key (used by Vite dev server /api/extract-recipe only, never expose as VITE_)
GEMINI_API_KEY=

# Client-side Firebase Web App configuration
# Only VITE_FIREBASE_API_KEY is required in GitHub Actions Secrets (other project IDs have defaults)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_FIRESTORE_DATABASE_ID=
